{
  "name": "BlockArena",
  "globIgnorePaths": ["**/.gitkeep"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Shared": { "$path": "src/ReplicatedStorage/Shared" },

      "//": "Remotes has no files: Shared/Remotes.luau creates the RemoteEvents at runtime. Without $ignoreUnknownInstances Rojo would prune them to match the empty directory.",
      "Remotes": {
        "$path": "src/ReplicatedStorage/Remotes",
        "$ignoreUnknownInstances": true
      }
    },

    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "Services": { "$path": "src/ServerScriptService/Services" }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": { "$path": "src/StarterPlayer/StarterPlayerScripts/Client" }
      }
    }
  }
}
